<Page x:Class="MiracleTraining.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleTraining"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Width="100"
           Height="100"
           Stretch="Uniform"
           Source="/res/logo.png"
           HorizontalAlignment="Left"
           VerticalAlignment="Center">
        </Image>
        <TextBlock Text="Miracle Show" FontSize="40" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Поиск:" FontSize="20" Margin="10" VerticalAlignment="Center"/>
            <TextBox Name="SearchTextBox" Margin="10" FontSize="20" VerticalAlignment="Center" Width="150" TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock Text="Сортировка:" FontSize="20" Margin="10" VerticalAlignment="Center"/>
            <ComboBox Name="SortComboBox" Margin="10" FontSize="20" VerticalAlignment="Center" Width="150" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Нет сортировки"/>
                <ComboBoxItem Content="По возрастанию цены"/>
                <ComboBoxItem Content="По убыванию цены"/>
            </ComboBox>
            <ComboBox Name="FiltrComboBox" Margin="10" FontSize="20" VerticalAlignment="Center" Width="150" SelectionChanged="FiltrComboBox_SelectionChanged">
                <ComboBoxItem Content="Нет фильтра"/>
                <ComboBoxItem Content="Детская одежда"/>
                <ComboBoxItem Content="Женская одежда"/>
                <ComboBoxItem Content="Мужская одежда"/>
            </ComboBox>
            <TextBlock Name="CountTextBlock" VerticalAlignment="Center" Margin="10"/>
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="150"
                       Height="150"
                       Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>

                        </Image>
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Название: " FontSize="20"/>
                                <TextBlock Text="{Binding ProductName}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Описание: " FontSize="20"/>
                                <TextBlock Text="{Binding Discription}" FontSize="20" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="цена: " FontSize="20"/>
                                <TextBlock Text="{Binding Price}" FontSize="20"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
